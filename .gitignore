# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/.env
/lib/tem.txt
/lib/temp/




# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Claude Code / agent skill caches — regenerable from skills-lock.json,
# don't need to be committed. .claude/settings.json and skills-lock.json
# itself are still tracked.
.claude/skills/
.agents/

# Stray local scratch files
/temp.txt

# Local working notes
doc/FeedbackNote.md
doc/Payment_plan.md

# ── Nested build output ───────────────────────────────────────────────────────
# The bare /build/ above only matches the repo root; Gradle also writes to
# android/build/. Trailing slash keeps android/build.gradle.kts tracked.
**/build/
.cxx/

# ── Signing material — never commit ───────────────────────────────────────────
*.jks
*.keystore
key.properties
*.p12
*.pem
*.cer
*.certSigningRequest
*.mobileprovision
ios/Runner/GoogleService-Info.plist
android/app/google-services.json

# ── Secrets ───────────────────────────────────────────────────────────────────
# /.env is covered above; catch the variants too, but keep the template.
.env.*
!.env.example

# ── Packaged build outputs ────────────────────────────────────────────────────
*.apk
*.aab
*.ipa
*.app.zip
*.xcarchive

# ── Native dependency caches ──────────────────────────────────────────────────
# Podfile.lock stays tracked (reproducible builds); the installed pods do not.
ios/Pods/
macos/Pods/
**/.symlinks/
**/Flutter/ephemeral/

# ── Tooling ───────────────────────────────────────────────────────────────────
.fvm/
*.iws
coverage/

# ── Signing and service credentials ───────────────────────────────────────────
# .p8 covers both App Store Connect API keys (AuthKey_*.p8) and In-App Purchase
# keys (SubscriptionKey_*.p8). Both are one-time downloads that unlock billing
# and account APIs, and both tend to land in the repo root straight from the
# browser.
*.p8
AuthKey_*.p8
SubscriptionKey_*.p8
*.cer
*.provisionprofile
# Google / Firebase service accounts
*service-account*.json
google-services.json
GoogleService-Info.plist
# Exported archives and signing material
*.xcarchive/
ExportOptions.plist.local
