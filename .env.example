# ──────────────────────────────────────────────────────────────────────────────
#  EVERYTHING IN .env SHIPS INSIDE THE APP
#
#  .env is declared as a Flutter asset in pubspec.yaml, so it is bundled into
#  the IPA and can be read out of the binary by anyone who downloads the app:
#
#      Payload/Runner.app/Frameworks/App.framework/flutter_assets/.env
#
#  Put ONLY values that are safe to publish here. Every key below is a client
#  identifier that Apple, Google or the vendor expects to be public.
#
#  NEVER put in this file:
#    · SUPABASE_SERVICE_ROLE / secret keys   (bypasses row-level security)
#    · database passwords or connection strings
#    · RevenueCat sk_ secret keys
#    · OpenAI, Anthropic or any provider key that bills you
#    · Apple .p8 keys, or anything else you downloaded once
#
#  Those belong on the backend — Cloud Run reads them from Secret Manager, see
#  services.yaml in the backend repo.
# ──────────────────────────────────────────────────────────────────────────────

# Supabase — the anon key is public by design; row-level security is what
# protects the data, not the secrecy of this value.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Backend. Optional: falls back to the Cloud Run URL in server_config.dart.
BACKEND_BASE_URL=

# Google Sign-In client identifiers. Public by design.
OAUTH_IOS_CLIENT=
OAUTH_ANDROID_CLIENT=

# RevenueCat public SDK keys (appl_ / goog_). Public by design — the secret
# sk_ key must never appear in the app.
REVENUECAT_IOS_API_KEY=
REVENUECAT_ANDROID_API_KEY=

# YouTube / RapidAPI keys for exercise videos.
#
# ⚠️ These are the one genuine risk in this file: they are billable and ship in
# the binary. Restrict them by bundle identifier (com.betfit.ai.app) in the
# Google Cloud console, or proxy the calls through the backend instead.
YOUTUBE_API_KEY=
YOUTUBE_RAPID_KEY=
